{
  "name": "multiclaude",
  "version": "2.0.0",
  "description": "Multi-agent terminal manager for Claude Code",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:ci": "tsc && vite build && electron-builder --publish never",
    "build:unpack": "npm run build -- --dir",
    "preview": "vite preview",
    "electron:dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "playwright test -c src/__tests__/e2e/playwright.config.ts",
    "test:ui:update": "playwright test -c src/__tests__/e2e/playwright.config.ts --update-snapshots",
    "test:ui:headed": "playwright test -c src/__tests__/e2e/playwright.config.ts --headed",
    "test:visual": "playwright test -c src/__tests__/e2e/playwright.config.ts --grep 'Visual Regression'",
    "test:visual:update": "playwright test -c src/__tests__/e2e/playwright.config.ts --grep 'Visual Regression' --update-snapshots",
    "test:themes": "playwright test -c src/__tests__/e2e/playwright.config.ts --grep 'Theme'",
    "release": "npm run build && electron-builder --publish always",
    "release:linux": "npm run build && electron-builder --linux --publish always",
    "release:win": "npm run build && electron-builder --win --publish always",
    "release:mac": "npm run build && electron-builder --mac --publish always",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyennguyenit/MultiClaude.git"
  },
  "keywords": [
    "electron",
    "terminal",
    "claude",
    "multi-agent"
  ],
  "author": {
    "name": "nguyennguyenit",
    "email": "nguyennlt.ncc@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.0.16",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/source-code-pro": "^5.2.7",
    "@fontsource/space-mono": "^5.2.9",
    "@lydell/node-pty": "^1.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.1.1",
    "simple-git": "^3.27.0",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "com.multiclaude.app",
    "productName": "MultiClaude",
    "publish": {
      "provider": "github",
      "owner": "nguyennguyenit",
      "repo": "MultiClaude"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "icon": "build/icon",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "deb": {
      "afterInstall": "scripts/postinst.sh",
      "maintainer": "nguyennguyenit <nguyennlt.ncc@gmail.com>"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    }
  }
}
